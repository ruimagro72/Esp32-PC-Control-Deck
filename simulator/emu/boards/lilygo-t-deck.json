{
  "id": "lilygo-t-deck",
  "name": "LilyGO T-Deck",
  "status": "profile-metadata-future",
  "display": {
    "width": 320,
    "height": 240,
    "panel": "landscape-st7789",
    "bus": "spi",
    "controller": "ST7789V",
    "pins": {
      "cs": 12,
      "dc": 11,
      "sclk": 40,
      "mosi": 41,
      "miso": 38,
      "bl": 42,
      "pwr_en": 10
    }
  },
  "touch": {
    "type": "capacitive",
    "controller": "GT911",
    "bus": "i2c",
    "addr": "0x5D",
    "pins": {
      "scl": 8,
      "sda": 18,
      "int": 16,
      "rst": null
    },
    "mapping": {
      "swap_xy": false,
      "invert_x": false,
      "invert_y": false
    },
    "calibration": {
      "x_off": 0,
      "y_off": 0
    }
  },
  "input": {
    "type": "touchscreen+keyboard",
    "matrix_keyboard": true,
    "keyboard_controller": "T-Deck-keyboard-over-I2C/BBQ10-style",
    "keyboard_bus": "i2c",
    "keyboard_addr": "0x55"
  },
  "buses": {
    "spi": [
      {
        "name": "lcd_spi",
        "pins": {
          "sclk": 40,
          "mosi": 41,
          "miso": 38
        }
      }
    ],
    "i2c": [
      {
        "name": "sensor_kb_touch_i2c",
        "pins": {
          "scl": 8,
          "sda": 18
        }
      }
    ],
    "uart": []
  },
  "cosim": {
    "device": "lilygo-t-deck",
    "wiring_hints": [
      "ST7789 SPI pins differ from es3c28p",
      "GT911 touch and keyboard controller not modeled in current sim_host"
    ]
  },
  "capabilities": {
    "supported": [
      "runtime-display-geometry-transform-if-applied"
    ],
    "needs_runtime_host": [
      "runtime-spi-pin-claims",
      "runtime-i2c-addr/controller",
      "touch-controller-gt911",
      "keyboard-matrix-device"
    ],
    "blocked_by_emu": [
      "gt911-protocol",
      "keyboard-device-model"
    ],
    "conditional": [
      "st7789-init-via-firmware-if-bus-claimed"
    ]
  },
  "notes": [
    "Structured for future GT911/keyboard support; current host models FT6336-style regfile touch and compile-time es3c28p claims only."
  ],
  "limits": {
    "runtime_configurable": [
      "display.width",
      "display.height",
      "display.mirror_x",
      "display.mirror_y",
      "touch.mapping.swap_xy",
      "touch.mapping.invert_x",
      "touch.mapping.invert_y",
      "touch.calibration.x_off",
      "touch.calibration.y_off",
      "hw_rot"
    ],
    "compile_time_or_conditional": [
      "display.bus",
      "display.controller",
      "display.spi_pins",
      "touch.type",
      "touch.controller",
      "touch.bus",
      "touch.addr",
      "touch.pins",
      "gpio_claims",
      "cosim_protocol"
    ],
    "emulator_limitations": [
      "non-es3c28p peripheral controllers/buses not fully modeled; profile metadata/validation only unless runtime host support exists"
    ]
  }
}
