{
  "id": "m5stack-cardputer",
  "name": "M5Stack Cardputer",
  "status": "profile-metadata-future",
  "display": {
    "width": 240,
    "height": 135,
    "panel": "landscape-st7789v2",
    "bus": "spi",
    "controller": "ST7789V2",
    "pins": {
      "cs": 37,
      "dc": 34,
      "sclk": 36,
      "mosi": 35,
      "miso": -1,
      "bl": 38,
      "rst": 33
    }
  },
  "touch": {
    "type": "none",
    "controller": "none",
    "bus": "none",
    "addr": null,
    "pins": {},
    "mapping": {
      "swap_xy": false,
      "invert_x": false,
      "invert_y": false
    },
    "calibration": {
      "x_off": 0,
      "y_off": 0
    }
  },
  "input": {
    "type": "matrix-keyboard",
    "matrix_keyboard": true,
    "keyboard_controller": "Cardputer-keyboard-matrix",
    "keyboard_scan": true
  },
  "buses": {
    "spi": [
      {
        "name": "lcd_spi",
        "pins": {
          "sclk": 36,
          "mosi": 35
        }
      }
    ],
    "i2c": [],
    "uart": [],
    "gpio_matrix": [
      {
        "name": "keyboard_matrix",
        "pins_note": "matrix scan pins per Cardputer schematic"
      }
    ]
  },
  "cosim": {
    "device": "m5stack-cardputer",
    "wiring_hints": [
      "Small 240x135 SPI LCD; keyboard matrix input not modeled in sim_host touch path"
    ]
  },
  "capabilities": {
    "supported": [
      "runtime-display-geometry-transform-if-applied"
    ],
    "needs_runtime_host": [
      "runtime-spi-pin-claims",
      "keyboard-matrix-input-device"
    ],
    "blocked_by_emu": [
      "keyboard-matrix-model"
    ],
    "conditional": [
      "st7789v2-init-via-firmware-if-bus-claimed"
    ]
  },
  "notes": [
    "No touch; keyboard matrix not modeled. Display geometry (240x135) can be applied at runtime, bus/controller claims remain compile-time."
  ],
  "limits": {
    "runtime_configurable": [
      "display.width",
      "display.height",
      "display.mirror_x",
      "display.mirror_y",
      "touch.mapping.swap_xy",
      "touch.mapping.invert_x",
      "touch.mapping.invert_y",
      "touch.calibration.x_off",
      "touch.calibration.y_off",
      "hw_rot"
    ],
    "compile_time_or_conditional": [
      "display.bus",
      "display.controller",
      "display.spi_pins",
      "touch.type",
      "touch.controller",
      "touch.bus",
      "touch.addr",
      "touch.pins",
      "gpio_claims",
      "cosim_protocol"
    ],
    "emulator_limitations": [
      "non-es3c28p peripheral controllers/buses not fully modeled; profile metadata/validation only unless runtime host support exists"
    ]
  }
}
