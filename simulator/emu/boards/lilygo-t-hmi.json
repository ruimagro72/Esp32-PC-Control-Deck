{
  "id": "lilygo-t-hmi",
  "name": "LilyGO T-HMI",
  "status": "profile-metadata-future",
  "display": {
    "width": 240,
    "height": 320,
    "panel": "portrait-st7789v",
    "bus": "parallel-8bit",
    "controller": "ST7789V-parallel",
    "pins": {
      "wr": 8,
      "rd": -1,
      "dc": 7,
      "cs": 6,
      "rst": -1,
      "te": -1,
      "bl": 38,
      "pwr_en": 10,
      "data": [
        "48",
        "47",
        "39",
        "40",
        "41",
        "42",
        "45",
        "46"
      ]
    }
  },
  "touch": {
    "type": "resistive",
    "controller": "XPT2046",
    "bus": "spi",
    "addr": null,
    "pins": {
      "cs": 2,
      "irq": 9,
      "miso": 4,
      "mosi": 3,
      "sclk": 1
    },
    "mapping": {
      "swap_xy": false,
      "invert_x": false,
      "invert_y": false
    },
    "calibration": {
      "x_off": 0,
      "y_off": 0
    }
  },
  "input": {
    "type": "touchscreen",
    "matrix_keyboard": false
  },
  "buses": {
    "spi": [
      {
        "name": "touch_spi",
        "pins": {
          "sclk": 1,
          "mosi": 3,
          "miso": 4,
          "cs": 2
        }
      }
    ],
    "i2c": [
      {
        "name": "pmu_or_sensors",
        "pins": {}
      }
    ],
    "uart": [],
    "parallel": [
      {
        "name": "lcd_parallel_8bit",
        "pins_ref": "display.pins"
      }
    ]
  },
  "cosim": {
    "device": "lilygo-t-hmi",
    "wiring_hints": [
      "Parallel LCD bus and XPT2046 resistive touch require dedicated host/emulator models"
    ]
  },
  "capabilities": {
    "supported": [
      "runtime-display-geometry-transform-if-applied"
    ],
    "needs_runtime_host": [
      "parallel-lcd-bus-model",
      "resistive-touch-model",
      "runtime-pin-bus-claims"
    ],
    "blocked_by_emu": [
      "parallel-display-controller-path",
      "xpt2046-protocol"
    ],
    "conditional": []
  },
  "notes": [
    "Parallel LCD and XPT2046 not modeled; profile captures intended wiring/controller for future implementation."
  ],
  "limits": {
