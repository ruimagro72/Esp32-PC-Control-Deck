    "compile_time_or_conditional": [
      "display.bus",
      "display.controller",
      "display.spi_pins",
      "touch.type",
      "touch.controller",
      "touch.bus",
      "touch.addr",
      "touch.pins",
      "gpio_claims",
      "cosim_protocol"
    ],
    "emulator_limitations": [
      "non-es3c28p peripheral controllers/buses not fully modeled; profile metadata/validation only unless runtime host support exists"
    ]
  }
