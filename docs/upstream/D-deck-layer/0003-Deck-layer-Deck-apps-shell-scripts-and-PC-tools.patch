+    Storage.load();
+
+    // --------------------------------------------------------------------------
+    // 6. GAME DEFINITIONS & ASSETS
+    // --------------------------------------------------------------------------
+    var GAME_MODES = [
+        { id: 0, name: "CLASSIC", desc: "Original pipes, pure skill" },
