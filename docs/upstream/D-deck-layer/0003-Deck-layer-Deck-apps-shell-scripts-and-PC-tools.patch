new file mode 100644
index 0000000..2473b25
--- /dev/null
+++ b/apps/decklink/main.js
@@ -0,0 +1,53 @@
+// Deck Link over BLE: the same GATT service as the old firmware (server/ble-bridge knows it).
+// Pairing uses a passkey shown here (display only, MITM, bonding). Colours: RGB565.
+var SVC = "c6d2fba6-17ec-4591-a399-4982dacbaf6d";
+var IN = "200a64c8-1a2b-4927-9c15-3783198616b4";    // PC -> Deck (write)
+var OUT = "d444ff04-43f4-4f30-8fc8-4b38a8466870";   // Deck -> PC (notify)
+var W = Display.width(), H = Display.height();
+function rgb(r, g, b) { var c = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3); return ((c & 0xFF) << 8) | (c >> 8); }   // RGB565, bytes swapped as KryonOS JS wants
+var C_BAR = rgb(16, 40, 80), C_TXT = rgb(255, 255, 255), C_DIM = rgb(170, 170, 170), C_KEY = rgb(255, 220, 0), C_OK = rgb(60, 200, 60);
+var lines = [], rx = 0;
+
+function draw(state, key) {
+    Display.fillScreen(0);
+    Display.fillRect(0, 0, W, 26, C_BAR);
+    Display.setTextColor(C_TXT, C_BAR); Display.drawString("Deck Link (BLE)", 6, 4, 4);
+    Display.setTextColor(state === "connected" ? C_OK : C_DIM, 0);
+    Display.drawString("State: " + state + "   received: " + rx + " B", 6, 32, 2);
+    if (key) { Display.setTextColor(C_KEY, 0); Display.drawString("Pairing code: " + key, 6, 54, 4); }
+    Display.setTextColor(C_TXT, 0);
+    for (var i = 0; i < lines.length; i++) Display.drawString(lines[i], 6, 90 + i * 16, 2);
+}
+function hex(a) { var s = ""; for (var i = 0; i < a.length && i < 16; i++) s += (a[i] < 16 ? "0" : "") + a[i].toString(16) + " "; return s; }
+
+Bluetooth.enable();
+Bluetooth._raw.setSecurity(false);   // TEST: no passkey while checking the data path
+// KryonOS's documented Server.addCharacteristic maps 'write' to 0x08 and 'notify' to 0x10
+// (ESP-IDF values), but the kernel uses the Arduino BLE library, where those mean broadcast
+// and indicate. So use _raw with the Arduino values.
+var P_READ = 1, P_WRITE = 2, P_NOTIFY = 4, P_WRITE_NR = 32;
+Bluetooth._raw.createServerService(SVC);
+Bluetooth._raw.addServerChar(SVC, IN, P_WRITE | P_WRITE_NR);
+Bluetooth._raw.addServerChar(SVC, OUT, P_READ | P_NOTIFY);
+Bluetooth._raw.startServer();
+var outChar = { setValue: function (d, n) { Bluetooth._raw.setServerCharVal(SVC, OUT, d, n); } };
+var adv = Bluetooth.BLE.Advertiser.start({ name: "Deck", serviceUUIDs: [SVC] });
+console.log("[decklink] advertising=" + adv + " mac=" + Bluetooth.getMacAddress());
+var state = "", key = 0, lastState = "x", lastKey = -1;
+
+while (true) {
+    System.delay(20);
+    System.getTouch();   // lets the OS exit corner (top-right X) close the app
+    state = Bluetooth._raw.isServerConnected() ? "connected" : "advertising as 'Deck'";
+    key = Bluetooth._raw.getPasskey();
+    var w;
+    while ((w = Bluetooth._raw.takeWrite()) !== null) {
+        rx += w.data.length;
+        lines.unshift("in " + w.data.length + " B: " + hex(w.data));
+        if (lines.length > 8) lines.pop();
+        console.log("[decklink] in " + w.data.length + " B " + hex(w.data));
+        outChar.setValue(w.data, true);   // echo for the test
+        lastState = "x";
+    }
+    if (state !== lastState || key !== lastKey) { draw(state, key ? ("000000" + key).slice(-6) : ""); lastState = state; lastKey = key; }
+}
