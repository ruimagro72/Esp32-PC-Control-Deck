diff --git a/shell/shell.js b/shell/shell.js
new file mode 100644
index 0000000..91ea37f
--- /dev/null
+++ b/shell/shell.js
@@ -0,0 +1,64 @@
+// The Deck's main screen (the shell, like explorer.exe). Runs after /sd/autoexec.js and again
+// each time an app closes. First version: one button per app, plus System (KryonOS's launcher,
+// the safe mode). It will become the Deck's pages, macros and server status.
+var W = Display.width(), H = Display.height();
+var BAR = 28, ROW = 38;
+function rgb(r, g, b) { var c = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3); return ((c & 0xFF) << 8) | (c >> 8); }   // RGB565, bytes swapped as KryonOS JS wants
+
+function apps() {
+    var list = [];
+    var roots = ["/sd/apps", "/local/apps"];
+    for (var r = 0; r < roots.length; r++) {
+        var items = [];
+        try { items = FS.listDir(roots[r]) || []; } catch (e) {}
+        for (var i = 0; i < items.length; i++) {
+            var name = items[i].substring(items[i].lastIndexOf("/") + 1);
+            if (name && name !== "deckshell") list.push({ name: name, path: items[i] + "/main.js" });   // deckshell: the launcher's way back here
+        }
+    }
+    return list;
+}
+
+var list = apps(), page = 0, perPage = Math.floor((H - BAR - ROW) / ROW);
+
+function draw() {
+    Display.fillScreen(0);
+    Display.fillRect(0, 0, W, BAR, rgb(30, 70, 160));
+    Display.setTextColor(rgb(255, 255, 255), rgb(30, 70, 160));
+    Display.drawString("Deck", 8, 6, 4);
+    var info = System.getInfo();
+    Display.drawString(Math.round(info.freeRAM / 1024) + " KB", W - 70, 8, 2);
+    for (var i = 0; i < perPage; i++) {
+        var k = page * perPage + i;
+        if (k >= list.length) break;
+        var y = BAR + 4 + i * ROW;
+        Display.fillRect(6, y, W - 12, ROW - 6, rgb(70, 80, 100));
+        Display.setTextColor(rgb(255, 255, 255), rgb(70, 80, 100));
+        Display.drawString(list[k].name, 14, y + 7, 2);
+    }
+    var by = H - ROW + 2;
+    Display.fillRect(6, by, 70, ROW - 6, rgb(90, 90, 90)); Display.setTextColor(rgb(255, 220, 0), rgb(90, 90, 90));
+    Display.drawString("<  >", 22, by + 7, 2);
+    Display.fillRect(W - 86, by, 80, ROW - 6, rgb(170, 30, 30)); Display.setTextColor(rgb(255, 255, 255), rgb(170, 30, 30));
+    Display.drawString("System", W - 74, by + 7, 2);
+}
+
+draw();
+var down = false, tx = 0, ty = 0;
+while (true) {
+    System.delay(20);
+    var t = System.getTouch();
+    if (t.touched) { down = true; tx = t.x; ty = t.y; continue; }
+    if (!down) continue;
+    down = false;
+    if (ty >= H - ROW) {
+        if (tx >= W - 86) break;                         // System: leave the shell (safe mode)
+        if (tx < 76) {                                    // next page, wraps
+            page = (page + 1) * perPage < list.length ? page + 1 : 0;
+            draw();
+        }
+        continue;
+    }
+    var k = page * perPage + Math.floor((ty - BAR - 4) / ROW);
+    if (ty > BAR && k >= 0 && k < list.length) System.launch(list[k].path);
+}
diff --git a/tools/Send.java b/tools/Send.java
new file mode 100644
index 0000000..28ec7f3
--- /dev/null
+++ b/tools/Send.java
@@ -0,0 +1,19 @@
+// Send one console command to the Deck and print the answer for a few seconds (JDK only).
+//   java Send.java PORT "command" [seconds]
+import java.io.*;
+
+public class Send {
+    public static void main(String[] a) throws Exception {
+        new ProcessBuilder("stty", "-F", a[0], "115200", "raw", "-echo").inheritIO().start().waitFor();
+        long wait = (a.length > 2 ? Long.parseLong(a[2]) : 3) * 1000;
+        try (FileOutputStream w = new FileOutputStream(a[0]); FileInputStream r = new FileInputStream(a[0])) {
+            w.write((a[1] + "\n").getBytes()); w.flush();
+            long end = System.currentTimeMillis() + wait;
+            byte[] buf = new byte[4096];
+            while (System.currentTimeMillis() < end) {
+                if (r.available() > 0) { int n = r.read(buf); System.out.write(buf, 0, n); System.out.flush(); }
+                else Thread.sleep(20);
+            }
+        }
+    }
+}
