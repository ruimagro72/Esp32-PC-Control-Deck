diff --git a/apps/led/main.js b/apps/led/main.js
new file mode 100644
index 0000000..23c35c7
--- /dev/null
+++ b/apps/led/main.js
@@ -0,0 +1,58 @@
+// Status LED test (WS2812 on GPIO 42 on the 2.8"). Colours: System.setLED(r, g, b).
+// Effects: System.ledEffect(name, r, g, b, periodMs) runs in a kernel task (keeps going after the
+// app ends unless stopped); on a kernel without it, BLINK is done here in JS and FADE/BREATHE say so.
+// The LED goes off when the app ends.
+var W = Display.width(), H = Display.height();
+function rgb(r, g, b) { var c = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3); return ((c & 0xFF) << 8) | (c >> 8); }   // RGB565, bytes swapped as KryonOS JS wants
+var HAS_FX = typeof System.ledEffect === "function";
+var BTN = [["RED", 255, 0, 0], ["GREEN", 0, 255, 0], ["BLUE", 0, 0, 255], ["WHITE", 255, 255, 255],
+           ["BLINK", "blink"], ["FADE", "fade"], ["BREATHE", "breathe"], ["OFF", 0, 0, 0]];
+var cols = 2, bw = Math.floor((W - 18) / cols), bh = Math.floor((H - 40) / 4) - 6;
+var last = [255, 255, 255], jsBlink = false;
+function box(i) { return { x: 6 + (i % cols) * (bw + 6), y: 34 + Math.floor(i / cols) * (bh + 6) }; }
+function draw(msg) {
+    Display.fillScreen(0);
+    Display.fillRect(0, 0, W, 26, rgb(30, 70, 160));
+    Display.setTextColor(rgb(255, 255, 255), rgb(30, 70, 160));
+    Display.drawString("Status LED  " + (msg || (HAS_FX ? "" : "(no kernel effects)")), 6, 5, 2);
+    for (var i = 0; i < BTN.length; i++) {
+        var b = box(i), c = BTN[i], fx = typeof c[1] === "string";
+        var bg = fx ? rgb(70, 80, 100) : rgb(c[1] / 2, c[2] / 2, c[3] / 2);
+        Display.fillRect(b.x, b.y, bw, bh, bg);
+        Display.setTextColor(rgb(255, 255, 255), bg);
+        Display.drawString(c[0], b.x + 10, b.y + bh / 2 - 8, 2);
+    }
+}
+function press(c) {
+    jsBlink = false;
+    if (typeof c[1] !== "string") {                       // a colour, or OFF
+        if (c[0] !== "OFF") last = [c[1], c[2], c[3]];
+        System.setLED(c[1], c[2], c[3]);
+        return c[0];
+    }
+    var period = c[1] === "blink" ? 600 : 2000;
+    if (HAS_FX) { System.ledEffect(c[1], last[0], last[1], last[2], period); return c[0]; }
+    if (c[1] === "blink") { jsBlink = true; return "BLINK (JS)"; }
+    return c[0] + " needs the next kernel";
+}
+draw("");
+var down = false, tx = 0, ty = 0, t0 = System.millis(), on = false;
+try {
+    while (true) {
+        System.delay(20);
+        if (jsBlink && System.millis() - t0 > 300) {
+            t0 = System.millis(); on = !on;
+            System.setLED(on ? last[0] : 0, on ? last[1] : 0, on ? last[2] : 0);
+        }
+        var t = System.getTouch();
+        if (t.touched) { down = true; tx = t.x; ty = t.y; continue; }
+        if (!down) continue;
+        down = false;
+        for (var i = 0; i < BTN.length; i++) {
+            var b = box(i);
+            if (tx >= b.x && tx < b.x + bw && ty >= b.y && ty < b.y + bh) draw(press(BTN[i]));
+        }
+    }
+} finally {
+    System.setLED(0, 0, 0);   // never leave it lit
+}
diff --git a/apps/lib/decknet.js b/apps/lib/decknet.js
new file mode 100644
index 0000000..e5732a3
--- /dev/null
+++ b/apps/lib/decknet.js
@@ -0,0 +1,144 @@
+// Deck protocol 4 in JavaScript (ES5, Duktape). docs/PROTOCOL.md: frames, COBS, CRC-16.
+// Over Wi-Fi: POST /api/deck, text/plain base64 of the COBS frames (KryonOS HTTP is text only).
+// Load in an app with: eval(FS.readTextFile("/sd/lib/decknet.js"));
+var DeckNet = (function () {
+    var seq = 0;
+    function crc16(b, n) {
+        var c = 0xFFFF;
