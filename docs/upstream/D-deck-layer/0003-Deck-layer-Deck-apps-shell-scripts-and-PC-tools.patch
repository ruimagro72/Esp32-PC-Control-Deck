+        console.log("[vnc] " + line + "  frames=" + frames + " in=" + bytesIn + " out=" + bytesOut +
+                    "  ram=" + si.freeRAM + " minram=" + si.minFreeRAM + " maxblock=" + si.maxAllocRAM);
+        lastT = now; lastFrames = frames; lastIn = bytesIn; lastPix = rectPixels;
+    }
+}
