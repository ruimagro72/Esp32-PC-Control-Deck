diff --git a/src/Kernel/DeckLink.cpp b/src/Kernel/DeckLink.cpp
new file mode 100644
index 0000000..26dd570
--- /dev/null
+++ b/src/Kernel/DeckLink.cpp
@@ -0,0 +1,197 @@
+#include "DeckLink.h"
+#include <WiFi.h>
+#include <deque>
+#include <vector>
+
+namespace DeckLink {
+namespace {
+constexpr uint8_t T_HELLO = 0x01, T_PONG = 0x02, T_CONSOLE_OUTPUT = 0x17;
+constexpr uint8_t T_HOST_HELLO = 0x40, T_PING = 0x41, T_CONSOLE_INPUT = 0x52;
+constexpr size_t MAX_FRAME = 4096, MAX_LINE = 512, MAX_QUEUE = 16, CHUNK = 900;
+const char *FIRMWARE = "kryon-0.8.0", *BOARD = "es3c28p";
+
+enum Mode : uint8_t { START, IN_FRAME, IN_LINE };
+Mode s_mode = START;
+std::vector<uint8_t> s_cobs;
+String s_line;
+std::deque<String> s_lines;
+std::deque<std::vector<uint8_t>> s_frames;
+bool s_greeted = false;
+uint32_t s_lastFrame = 0;   // a greeted server sends stats every few seconds
+uint16_t s_seq = 0;
+void (*s_runner)(const String &, Print &) = nullptr;
+
+uint16_t crc16(const uint8_t *b, size_t n) {   // CRC-16/CCITT-FALSE, as Frame4.crc16
+    uint16_t c = 0xFFFF;
+    for (size_t i = 0; i < n; i++) {
+        c ^= (uint16_t)b[i] << 8;
+        for (int k = 0; k < 8; k++) c = (c & 0x8000) ? (uint16_t)((c << 1) ^ 0x1021) : (uint16_t)(c << 1);
+    }
+    return c;
+}
+
+bool uncobs(const std::vector<uint8_t> &in, std::vector<uint8_t> &out) {
+    out.clear();
+    size_t p = 0;
+    while (p < in.size()) {
+        uint8_t code = in[p++];
+        if (code == 0) return false;
+        for (uint8_t i = 1; i < code; i++) { if (p >= in.size()) return false; out.push_back(in[p++]); }
+        if (code < 0xFF && p < in.size()) out.push_back(0);
+    }
+    return true;
+}
+
+// Writer for payload fields (little endian, str = u8 length + UTF-8, str16 = u16 length).
+struct W {
+    std::vector<uint8_t> a;
+    W &u8(uint8_t v) { a.push_back(v); return *this; }
+    W &u16(uint16_t v) { a.push_back(v & 255); a.push_back(v >> 8); return *this; }
+    W &str(const String &s) { size_t n = s.length() > 255 ? 255 : s.length(); u8(n); a.insert(a.end(), s.c_str(), s.c_str() + n); return *this; }
+    W &str16(const char *s, size_t n) { u16(n); a.insert(a.end(), s, s + n); return *this; }
+};
+
+void sendHello() {
+    W w; w.u8(4).str(deckId()).str(FIRMWARE).str(BOARD);
+    send(T_HELLO, w.a.data(), w.a.size());
+}
+
+// Answer of one console line, in parts of CHUNK bytes; flags bit 0 marks the last part.
+void consoleOutput(uint16_t id, const String &text) {
+    size_t n = text.length(), at = 0;
+    do {
+        size_t len = n - at > CHUNK ? CHUNK : n - at;
+        W w; w.str(deckId()).u16(id).u8(at + len >= n ? 1 : 0).str16(text.c_str() + at, len);
+        send(T_CONSOLE_OUTPUT, w.a.data(), w.a.size());
+        at += len;
+    } while (at < n);
+}
+
+struct StrPrint : Print {
+    String s;
+    size_t write(uint8_t c) override { s += (char)c; return 1; }
+};
+
+void handle(std::vector<uint8_t> &f) {
+    if (f.size() < 10 || (f[0] & 0xF0) != 0x40) return;
+    size_t n = f[6] | (f[7] << 8);
+    if (f.size() < 10 + n) return;
+    if (crc16(f.data(), 8 + n) != (uint16_t)(f[8 + n] | (f[9 + n] << 8))) return;   // damaged
+    s_lastFrame = millis();
+    uint8_t type = f[2];
+    const uint8_t *p = f.data() + 8;
+    if (type == T_PING) {
+        if (s_greeted) send(T_PONG, nullptr, 0); else sendHello();
+        return;
+    }
+    if (type == T_HOST_HELLO) s_greeted = true;   // the app may want it too: queued below
+    if (type == T_CONSOLE_INPUT && n >= 3) {
+        uint16_t id = p[0] | (p[1] << 8);
+        size_t len = p[2] < n - 3 ? p[2] : n - 3;
+        String line;
+        for (size_t i = 0; i < len; i++) line += (char)p[3 + i];
+        StrPrint out;
+        if (s_runner) s_runner(line, out); else out.print("no console");
+        consoleOutput(id, out.s);
+        return;
+    }
+    if (s_frames.size() >= MAX_QUEUE) s_frames.pop_front();   // no app reading: keep the newest
+    s_frames.push_back(f);
+}
+}  // namespace
+
+void poll() {
+    // A server that restarted pings again and waits for a hello: forget the greeting when quiet.
+    if (s_greeted && millis() - s_lastFrame > 10000) s_greeted = false;
+    while (Serial.available()) {
+        int c = Serial.read();
+        if (c < 0) break;
+        switch (s_mode) {
+            case START:
+                if (c == 0x02) { s_cobs.clear(); s_cobs.push_back(c); s_mode = IN_FRAME; }
+                else if (c == 0x00 || c == '\r' || c == '\n') { }
+                else { s_line = (char)c; s_mode = IN_LINE; }
+                break;
+            case IN_FRAME:
+                if (c == 0x00) {
+                    std::vector<uint8_t> raw;
+                    if (uncobs(s_cobs, raw)) handle(raw);
+                    s_mode = START;
+                } else if (s_cobs.size() < MAX_FRAME) s_cobs.push_back(c);
+                else s_mode = START;   // too long: drop it
+                break;
+            case IN_LINE:
+                if (c == '\n') {
+                    s_line.trim();
+                    s_mode = START;
+                    // Stop here: a "put" line is followed by raw file bytes that serialPut reads itself.
+                    if (s_line.length()) { s_lines.push_back(s_line); return; }
+                }
+                else if (c == 0x00) s_mode = START;   // a damaged line
+                else if (s_line.length() < MAX_LINE) s_line += (char)c;
+                break;
+        }
+    }
+}
+
+bool takeLine(String &line) {
+    poll();
+    if (s_lines.empty()) return false;
+    line = s_lines.front();
+    s_lines.pop_front();
+    return true;
+}
+
+bool takeFrame(std::vector<uint8_t> &frame) {
+    poll();
+    if (s_frames.empty()) return false;
+    frame = std::move(s_frames.front());
+    s_frames.pop_front();
+    return true;
+}
+
+void sendRaw(const uint8_t *src, size_t n) {
+    std::vector<uint8_t> out;
+    out.reserve(n + n / 254 + 2);
+    size_t ci = 0;
+    out.push_back(0);
+    uint8_t code = 1;
+    for (size_t i = 0; i < n; i++) {
+        if (src[i] == 0) { out[ci] = code; ci = out.size(); out.push_back(0); code = 1; }
+        else {
+            out.push_back(src[i]);
+            if (++code == 0xFF) { out[ci] = code; ci = out.size(); out.push_back(0); code = 1; }
+        }
+    }
+    out[ci] = code;
+    out.push_back(0);
+    Serial.write(out.data(), out.size());   // one write: log lines from other tasks cannot split it
+}
+
+void send(uint8_t type, const uint8_t *payload, size_t n) {
+    std::vector<uint8_t> f = {0x40, 0, type, 0, (uint8_t)(s_seq & 255), (uint8_t)(s_seq >> 8),
+                              (uint8_t)(n & 255), (uint8_t)(n >> 8)};
+    s_seq++;
+    if (n) f.insert(f.end(), payload, payload + n);
+    uint16_t c = crc16(f.data(), f.size());
+    f.push_back(c & 255);
+    f.push_back(c >> 8);
+    sendRaw(f.data(), f.size());
+}
+
+bool greeted() { return s_greeted; }
+
+String deckId() {
+    uint8_t m[6];
+    WiFi.macAddress(m);
+    char s[13];
+    snprintf(s, sizeof s, "%02X%02X%02X%02X%02X%02X", m[0], m[1], m[2], m[3], m[4], m[5]);
+    return String(s);
+}
+
+void liveLog(const String &text) {
+    if (s_greeted) consoleOutput(0, text);
+}
+
+void setConsoleRunner(void (*run)(const String &, Print &)) { s_runner = run; }
+}  // namespace DeckLink
