+#pragma once
+// DeckLink: the Deck protocol 4 on the USB serial port, shared with the text console.
+//
+// The port carries two things, told apart by the first byte of each unit (docs/PROTOCOL.md,
+// "On the serial line"): 0x02 starts a COBS frame that ends with 0x00 (a frame's header is
+// 0x40 0x00 ..., so COBS always begins it with 2); anything else is a console text line up to
+// '\n'. Console commands never start with 0x02, and the server skips text lines (logs).
+//
+// The kernel answers by itself, with or without an app: ping -> hello (until host_hello), then
+// pong; console_input -> the console runs the line and the answer goes back as console_output.
+// Every other frame waits in a small queue for the Deck app (JS: DeckLink.read / DeckLink.write).
+#include <Arduino.h>
+#include <vector>
+
+namespace DeckLink {
+// Read the serial port; call often (main loop, and from apps' housekeeping).
+void poll();
+
+// The next console text line typed on the port, if any (frames never come out here).
+bool takeLine(String &line);
+
+// A frame for the app (raw, COBS removed, CRC checked), oldest first; false when none.
+bool takeFrame(std::vector<uint8_t> &frame);
+
+// Send a raw frame (header .. CRC) COBS-encoded with its 0x00, in one write.
+void sendRaw(const uint8_t *frame, size_t n);
+
+// Build and send a frame of this type (header, sequence, CRC added here).
+void send(uint8_t type, const uint8_t *payload, size_t n);
+
+// True once the server answered our hello with host_hello on this port.
+bool greeted();
+
+// The id the Deck gives in hello and console_output: the Wi-Fi MAC, 12 hex digits.
+String deckId();
+
+// A live log line (console_output with request id 0) when a server is greeted; else nothing.
+void liveLog(const String &text);
+
+// Set by main.cpp: runs one console line, writing its answer to `out`.
+void setConsoleRunner(void (*run)(const String &line, Print &out));
+}  // namespace DeckLink
